# ---------------------------------------------------------------------------
# মোঃ আবু তাহের — ক্যাম্পেইন সাইট (Django + PostgreSQL)
# এই ফাইলটি `.env` নামে কপি করে নিজের মান বসান। `.env` কখনো গিটে তুলবেন না।
# ---------------------------------------------------------------------------

# PostgreSQL সংযোগ (প্রাইমারি)
# লোকাল: postgresql://postgres:password@127.0.0.1:5432/mdabutaher
# Supabase: postgresql://postgres.xxxx:pass@aws-0-...pooler.supabase.com:6543/postgres?sslmode=require
# Neon: postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Railway: postgresql://postgres:pass@containers-us-west-x.railway.app:7000/railway
DATABASE_URL=postgresql://mdabutaher:strong-password@127.0.0.1:5432/mdabutaher

# না দিলে আলাদা ভেরিয়েবলও চলবে
# POSTGRES_DB=mdabutaher
# POSTGRES_USER=mdabutaher
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# সিকিউরিটি — প্রোডাকশনে অবশ্যই বদলান (৫০+ র‍্যান্ডম অক্ষর)
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mdabutaher.com,www.mdabutaher.com,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://mdabutaher.com,https://www.mdabutaher.com
DJANGO_SECURE_COOKIES=1
# HTTPS-এর পেছনে থাকলে ছাড়ুন; লোকাল HTTP-তে 0
# DJANGO_HSTS_SECONDS=31536000

# প্রথম অ্যাডমিন (seed_content চালালে তৈরি হবে)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=mahadan-2027
ADMIN_EMAIL=taher.stone@gmail.com
