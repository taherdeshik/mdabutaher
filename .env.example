# মহাদান ইউনিয়ন প্রচারণা প্ল্যাটফর্ম — Django environment
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mdabutaher.com,www.mdabutaher.com,localhost,127.0.0.1
# পাবলিক সাইটের ঠিকানা (canonical / sitemap / OG URL)
SITE_URL=https://mdabutaher.com
# CSRF: ALLOWED_HOSTS থেকে স্বয়ংক্রিয়ভাবে তৈরি হয় (.example.com → https://*.example.com)।
# অতিরিক্ত origin লাগলে (কমা-দিয়ে): DJANGO_CSRF_TRUSTED_ORIGINS=https://other.example.org

# ---------------------------
# ডেটাবেস — PostgreSQL (সুপারিশকৃত)
# এই চারটি সেট থাকলে PostgreSQL ব্যবহার হয়। `pip install -r requirements-postgres.txt`
# ---------------------------
# আপলোড করা ছবি/ভিডিও/অডিওর ফোল্ডার (ডিফল্ট: প্রজেক্টের uploads/; Git-এর বাইরে রাখুন)
# MEDIA_ROOT=/home/user/mahadan-uploads
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mahadan
POSTGRES_USER=mahadan
POSTGRES_PASSWORD=change-this-password
# POSTGRES_SSLMODE=require        # রিমোট সার্ভারে SSL লাগলে
# POSTGRES_CONN_MAX_AGE=60        # কানেকশন পুনর্ব্যবহারের সময় (সেকেন্ড)

# ---------------------------
# ডেটাবেস — MySQL / MariaDB (পুরোনো cPanel সেটআপ; POSTGRES_* না থাকলে ব্যবহৃত হয়)
# ---------------------------
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=cpaneluser_campaign
# MYSQL_PASSWORD=change-this-password
# MYSQL_DATABASE=cpaneluser_mdabutaher
# MYSQL_SSL=1

# কিছুই না দিলে SQLite (data/db.sqlite3) ব্যবহার হয় — শুধু ডেভেলপমেন্টের জন্য।

# ---------------------------
# অ্যাডমিন বুটস্ট্র্যাপ — প্রথম migrate-এর সময় owner অ্যাকাউন্ট তৈরি হয় (একবারই)
# ---------------------------
ADMIN_NAME=মোঃ আবু তাহের
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
