# অ্যাপ্লিকেশন
NODE_ENV=production
# পাবলিক সাইটের ঠিকানা (canonical / sitemap / OG URL)
NEXT_PUBLIC_SITE_URL=https://mdabutaher.com

# ---------------------------
# ডেটাবেস — cPanel MySQL / MariaDB
# ---------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cpaneluser_campaign
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=cpaneluser_mdabutaher
# রিমোট MySQL হলে (কমলা/নীল হোস্ট) MYSQL_SSL=1 দিন
# MYSQL_SSL=0

# ---------------------------
# অ্যাডমিন লগইন
# ---------------------------
# প্রথম রান/লগইনে এই তথ্য দিয়ে owner অ্যাকাউন্ট তৈরি হয় (একবারই)।
ADMIN_NAME=মোঃ আবু তাহের
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
# পুরোনো সিঙ্গেল-কী লগইন দরকার হলে (মাইগ্রেশনের সময়); না দিলে বন্ধ থাকে।
# ADMIN_KEY=

# ---------------------------
# ঐচ্ছিক
# ---------------------------
# ভিজিটর জিও লোকেশন (হোস্টিং হেডার না দিলে টাইমজোন থেকে অনুমান হয়)
# GEO_COUNTRY_HEADER=x-vercel-ip-country
# GEO_CITY_HEADER=x-vercel-ip-city
